# Local PostgreSQL test configuration. Copy to .env.test; passwords stay in ~/.pgpass.
SPACE_CORP_TEST_DATABASE_URL=postgresql+psycopg://space_corp_app@localhost:5432/space_corp_test
SPACE_CORP_TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://space_corp@localhost:5432/space_corp_test
# Enables disposable PostgreSQL provisioning tests. Replace for a non-Homebrew installation.
SPACE_CORP_TEST_POSTGRES_BIN=/opt/homebrew/opt/postgresql@17/bin
