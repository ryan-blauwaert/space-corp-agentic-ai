# Local application configuration. Copy to .env, migrate, and run the seed command.
# Passwords remain in your ignored ~/.pgpass file or another local credential store.
SPACE_CORP_ENVIRONMENT=development
SPACE_CORP_DATABASE_URL=postgresql+psycopg://space_corp_app@localhost:5432/space_corp
SPACE_CORP_MIGRATION_DATABASE_URL=postgresql+psycopg://space_corp@localhost:5432/space_corp
SPACE_CORP_DEFAULT_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
